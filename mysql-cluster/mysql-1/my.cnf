[mysqld]
# Identity: must be unique per node
server_id=101
report_host=mysql-1

# Binary log + GTIDs: required for Group Replication
log_bin=mysql-bin
binlog_format=ROW
gtid_mode=ON
enforce_gtid_consistency=ON
log_replica_updates=ON

# Load the Group Replication plugin (MySQL Shell configures the rest)
plugin_load_add=group_replication.so

bind_address=0.0.0.0
